POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
# Studio asks PostgreSQL to close idle sessions after these durations. Set to 0 to disable.
POSTGRES_IDLE_SESSION_TIMEOUT=30min
POSTGRES_IDLE_IN_TRANSACTION_SESSION_TIMEOUT=10min

RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=LJqEG9RE4FdZbVWoJzZIOQEI

# Number of Celery prefork worker processes.
CELERY_CONCURRENCY=4

# configuration for the event-listener
USERNAME=${EVENT_USER_EMAIL}
PASSWORD=${EVENT_USER_PASSWORD}
BASE_URL=http://studio.127.0.0.1.nip.io:8080
TLS_SSL_VERIFICATION=0  # if need to disable tls/ssl verification
APP_PROBE_STATUSES=Running,Deleted
